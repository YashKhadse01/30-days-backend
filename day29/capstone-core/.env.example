POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql+asyncpg://capstone:replace-with-a-strong-local-password@127.0.0.1:55432/capstone_db
REDIS_URL=redis://127.0.0.1:56379/0
JWT_SECRET_KEY=replace-with-a-random-secret

TOTP_ENCRYPTION_KEY=replace-with-a-random-32-byte-or-longer-secret

# Google OpenID Connect
# Configure these only after creating a Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback

# Required when Google OAuth login is enabled.
# Generate a random secret locally; never commit the real value.
OAUTH_SESSION_SECRET=

# SHA-256 hash of a securely generated API key.
API_KEY_SHA256=
