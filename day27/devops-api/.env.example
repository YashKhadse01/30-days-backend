
# Application
APP_NAME="Day 27 - DevOps API"
APP_ENV=development

# PostgreSQL credentials
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Local database connection
DATABASE_URL=postgresql+asyncpg://devops:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/devops_db

# Docker database connection
DATABASE_URL_DOCKER=postgresql+asyncpg://devops:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/devops_db

# Redis
REDIS_URL=redis://localhost:6379/0
